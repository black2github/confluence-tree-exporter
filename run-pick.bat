@echo off
REM ============================================================================
REM  Точечная замена страниц выгрузки страницами из новой полной выгрузки
REM  (утилита pick_pages). Доступ к Confluence не нужен.
REM
REM  Зачем: после исправлений экспорта часть страниц нужно выгрузить заново.
REM  Выгрузка страницы поодиночке кладет ее в корень, вне структуры дерева.
REM  Поэтому: сначала полная выгрузка run-tree.bat во ВРЕМЕННЫЙ каталог, затем
REM  эта утилита переносит в старую выгрузку только страницы из списка - по
REM  тем же относительным путям, вместе с картинками.
REM
REM  Использование:
REM    run-pick.bat <новая выгрузка> <старая выгрузка> --pages <файл> [--dry-run]
REM                 [--out <файл отчета>]
REM
REM    <новая выгрузка>, <старая выгрузка>  каталоги ОДНОГО уровня дерева
REM    --pages <файл>   список идентификаторов страниц: по одному в строке
REM                     или через пробел/запятую; строки с # - комментарии
REM    --dry-run        показать план, ничего не записывая
REM    --out <файл>     записать отчет в markdown-файл
REM
REM  Примеры:
REM    run-pick.bat conf-new\adm\kk conf-requirements\adm\kk --pages ids.txt --dry-run
REM    run-pick.bat conf-new\adm\kk conf-requirements\adm\kk --pages ids.txt
REM
REM  Все или ничего: если хоть одна страница из списка не найдена в новой
REM  выгрузке или целевой путь занят другой страницей - не записывается ничего.
REM  Порядок работы: сначала --dry-run и просмотр итога, затем без него.
REM  Код возврата: 0 - выполнено, 1 - ошибки плана, 2 - ошибка запуска.
REM ============================================================================
setlocal
cd /d "%~dp0"
if not exist ".venv\Scripts\python.exe" (
    echo ОШИБКА: окружение не установлено. Сначала запустите install.bat
    exit /b 1
)
set "PYTHONPATH=%~dp0"
".venv\Scripts\python.exe" -m app.scripts.pick_pages %*
endlocal
