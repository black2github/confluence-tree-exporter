@echo off
REM ============================================================================
REM  Сверка страничных флагов заморозки уже сделанной выгрузки с историей
REM  изменений страниц в Confluence (утилита audit_page_flags).
REM  ТОЛЬКО ЧТЕНИЕ: файлы выгрузки не меняются. Нужен доступ к Confluence,
REM  поэтому запускается на внутреннем контуре.
REM
REM  Зачем: до версии 1.9.1 экспорт замораживал страницу целиком, если задача
REM  из списка --unapproved-jira стояла в ЛЮБОЙ черной строке истории. Задача
REM  в середине истории давно введенной страницы давала тот же результат, и
REM  reject-all оставлял от страницы один заголовок. Сверка находит такие
REM  страницы в старой выгрузке.
REM
REM  Использование:
REM    run-audit.bat <каталог выгрузки> [--out <файл отчета>]
REM                  [--unapproved-jira <file.json>]
REM
REM    --out <файл>                   записать отчет в markdown-файл
REM    --unapproved-jira <file.json>  тот же список, что давали экспорту;
REM                                   без него правило проверяется для задачи
REM                                   из флага страницы (этого достаточно)
REM
REM  Примеры:
REM    run-audit.bat conf-requirements\ --out audit.md
REM
REM  Итог в последней строке: сколько страниц заморожено ошибочно. Такие
REM  страницы перечислены в отчете; их нужно выгрузить заново этой версией.
REM  Код возврата: 0 - ошибочных нет, 1 - есть, 2 - ошибка запуска.
REM ============================================================================
setlocal
cd /d "%~dp0"
if not exist ".venv\Scripts\python.exe" (
    echo ОШИБКА: окружение не установлено. Сначала запустите install.bat
    exit /b 1
)
set "PYTHONPATH=%~dp0"
".venv\Scripts\python.exe" -m app.scripts.audit_page_flags %*
endlocal
