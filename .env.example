# =====================================================================
# Настройки доступа к Confluence.
# Скопируйте этот файл в .env (в том же каталоге) и заполните значения.
#   copy .env.example .env
# =====================================================================

# Базовый URL вашего Confluence (без /wiki и без завершающего слэша), например:
CONFLUENCE_BASE_URL=https://confluence.int.gazprombank.ru

# Учётные данные (basic-аутентификация: логин + пароль).
CONFLUENCE_USER=gpbuXXXXX
CONFLUENCE_PASSWORD=

# --- Необязательные настройки ------------------------------------------------

# Если REST API Confluence закрыт, но страницы открываются в браузере —
# включите прямой HTTP-режим (выгрузка ходит как браузер, в обход REST API).
# То же самое можно включить флагом --http в командной строке.
# CONFLUENCE_USE_HTTP=false

# Выгружать ВСЁ содержимое, включая неподтверждённые (цветные) фрагменты.
# По умолчанию сохраняются только подтверждённые ("чёрные"). Флаг CLI: --all
# MIGRATE_INCLUDE_UNAPPROVED=false

# Удалять из начала страниц таблицу "История изменений" (по умолчанию — да).
# Флаг CLI, чтобы сохранить историю: --keep-history
# REMOVE_HISTORY_SECTIONS=true

# Скачивать картинки в подкаталог img/ рядом с .md. Флаг CLI: --with-images
# MIGRATE_IMAGES=false

# Если Confluence за самоподписанным сертификатом и коннект не проходит —
# проверку SSL можно отключить, поправив verify_ssl=False в app/confluence_loader.py.
